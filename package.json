{
  "name": "dsh-notify",
  "version": "0.1.1",
  "description": "Windows toast notifications for DeepSeek Harness: approval prompts, agent questions, finished and failed turns.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/chime.wav",
    "assets/whale-on-dark.ico",
    "assets/whale-on-light.ico",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "windows",
    "toast",
    "notification"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoLeigh/dsh-notify.git"
  },
  "homepage": "https://github.com/XiaoLeigh/dsh-notify#readme",
  "bugs": {
    "url": "https://github.com/XiaoLeigh/dsh-notify/issues"
  },
  "author": "XiaoLeigh <1544314809@qq.com>",
  "license": "MIT"
}